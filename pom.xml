<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nomendi6.orgsec</groupId>
    <artifactId>orgsec-parent</artifactId>
    <version>1.0.5</version>
    <packaging>pom</packaging>

    <name>OrgSec Parent</name>
    <description>Parent POM for OrgSec - Spring Boot library for organizational role-based access control</description>
    <url>https://github.com/Nomendi6/orgsec</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Nomendi6</id>
            <name>Nomendi 6 d.o.o.</name>
            <email>ivan.vrbovcan@nomendi6.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/Nomendi6/orgsec.git</connection>
        <developerConnection>scm:git:ssh://github.com/Nomendi6/orgsec.git</developerConnection>
        <url>https://github.com/Nomendi6/orgsec</url>
    </scm>

    <modules>
        <module>orgsec-core</module>
        <module>orgsec-common</module>
        <module>orgsec-spring-boot-starter</module>
        <module>orgsec-storage-inmemory</module>
        <module>orgsec-storage-redis</module>
        <module>orgsec-storage-jwt</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!--
            `release`, not `source`/`target`. The latter pair emits Java 17 bytecode but still links
            against whichever JDK runs the build, so a build on JDK 21 can reference methods that do
            not exist on Java 17 and fail only at runtime, in the consumer's application. `release`
            makes javac refuse them at compile time, which turns "the operator used the right JDK"
            from a procedure into a property of the build.
        -->
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Library versions -->
        <spring-boot.version>3.5.14</spring-boot.version>
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <assertj.version>3.26.3</assertj.version>
        <slf4j.version>2.0.17</slf4j.version>
        <jakarta.persistence.version>3.1.0</jakarta.persistence.version>
        <jakarta.validation.version>3.0.2</jakarta.validation.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <commons-codec.version>1.17.1</commons-codec.version>

        <!-- Maven Plugin Versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.3.0</maven-surefire-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.7.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.4</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.10.0</central-publishing-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
        <japicmp-maven-plugin.version>0.25.6</japicmp-maven-plugin.version>

        <!-- Baseline the 1.x line is compared against at `verify`. Bump on every release. -->
        <binary.compat.old.version>1.0.4</binary.compat.old.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!--
                            spring-boot-starter-parent sets this; we only import the BOM, so it
                            has to be set here. Without it the published jars carry no
                            MethodParameters attribute and Spring MVC cannot resolve
                            @PathVariable/@RequestParam names in PersonApiController.
                        -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <quiet>true</quiet>
                        <failOnError>false</failOnError>
                        <failOnWarnings>false</failOnWarnings>
                        <additionalOptions>-Xdoclint:none</additionalOptions>
                        <additionalJOptions>
                            <additionalJOption>-Xdoclint:none</additionalJOption>
                        </additionalJOptions>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                    <!-- Configuration in 'release' profile -->
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>true</autoPublish>
                        <waitUntil>published</waitUntil>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp-maven-plugin.version}</version>
                    <configuration>
                        <skipPomModules>true</skipPomModules>
                        <oldVersion>
                            <dependency>
                                <groupId>${project.groupId}</groupId>
                                <artifactId>${project.artifactId}</artifactId>
                                <version>${binary.compat.old.version}</version>
                                <type>jar</type>
                            </dependency>
                        </oldVersion>
                        <newVersion>
                            <file>
                                <path>${project.build.directory}/${project.build.finalName}.jar</path>
                            </file>
                        </newVersion>
                        <parameter>
                            <onlyModified>true</onlyModified>
                            <breakBuildOnModifications>false</breakBuildOnModifications>
                            <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                            <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                            <includeSynthetic>false</includeSynthetic>
                            <ignoreMissingClasses>true</ignoreMissingClasses>
                        </parameter>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <executions>
                    <!--
                        Informational: always produce the full API diff against the previous
                        release. 1.0.5 is a patch, so the diff is expected to be additive only -
                        but it must be visible and signed off before deploy (Faza D k.5).
                    -->
                    <execution>
                        <id>api-diff-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                    <!--
                        Enforcing: the types below are the contract the Applipress generator
                        scaffolds against. Any incompatible change here fails the build.
                    -->
                    <execution>
                        <id>enforce-stable-public-api</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <parameter>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <includes>
                                    <include>com.nomendi6.orgsec.storage.SecurityDataStorage</include>
                                    <include>com.nomendi6.orgsec.interfaces.SecurityEnabledEntity</include>
                                    <include>com.nomendi6.orgsec.api.PrivilegeRegistry</include>
                                    <include>com.nomendi6.orgsec.api.PrivilegeDefinitionProvider</include>
                                    <include>com.nomendi6.orgsec.provider.SecurityContextProvider</include>
                                    <include>com.nomendi6.orgsec.common.service.SecurityEventPublisher</include>
                                    <include>com.nomendi6.orgsec.model.PersonDef</include>
                                    <include>com.nomendi6.orgsec.model.RoleDef</include>
                                    <include>com.nomendi6.orgsec.model.PrivilegeDef</include>
                                    <include>com.nomendi6.orgsec.model.OrganizationDef</include>
                                    <include>com.nomendi6.orgsec.model.BusinessRoleDef</include>
                                    <include>com.nomendi6.orgsec.model.ResourceDef</include>
                                </includes>
                            </parameter>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <!-- GPG key configured in settings.xml or via -Dgpg.keyname=... -->
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
